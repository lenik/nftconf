"""Demo/source-tree entry — delegates to nftconf.py."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path

_main = Path(__file__).resolve().parent / "nftconf.py"
if not _main.is_file():
    sys.stderr.write("nftconf: nftconf.py not found next to this wrapper\n")
    raise SystemExit(1)
runpy.run_path(str(_main), run_name="__main__")
