msgstr "將 nftconf FILE 轉換為 nftables.d/*.nft"

#: nftconf_app/cli.py:178
msgid "output file (single input only); default nftables.d/<stem>.nft"
msgstr "輸出檔（僅單一輸入）；預設 nftables.d/<stem>.nft"

#: nftconf_app/cli.py:182
msgid "show this help"
msgstr "顯示此說明"
