#: nftconf_app/cli.py:53
msgid "Declarative nftables config (live reconcile)"
msgstr "宣告式 nftables 設定（即時對帳）"

#: nftconf_app/cli.py:56
msgid ""
"Conflict policy (load / daemon):\n"
"  default          abort if existing nft settings conflict\n"
"  -f, --force      overwrite conflicting live rules (load)\n"
"  -n, --no-clobber skip conflicting changes; leave existing settings alone\n"
"\n"
"load -c/--compact packs matching allow/deny statements into nft sets.\n"
"unload removes a statement only when the whole live rule matches;\n"
"unload -f/--force splits a leftover compacted rule and removes as many\n"
"atoms as possible.\n"
"show prints each statement with status: on, N/M, ---, xxx.\n"
"\n"
"Global options (before or after CMD):\n"
"  -v, --verbose    DEBUG logging\n"
"  -q, --quiet      ERROR only\n"
"  -h, --help       show help\n"
"  --version        show version\n"
"\n"
"Notes:\n"
"  NAT (nat/dnat/redirect) is handled in prerouting/forward — it does not\n"
"  open INPUT. Use allow incoming / whitelist for ports that need host\n"
"  delivery (SSH, etc.). deny incoming drops a port; allow outgoing ip CIDR\n"
"  [tcp/udp PORT...] filters OUTPUT (omit ports to match all traffic).\n"
"  A single port beats a range; at the same specificity, allow beats deny.\n"
"  dest address / dest interface set defaults for the nat … to … side.\n"
"  TCP/UDP matches take a port, a range (8000-8080), or a list\n"
"  (80 443 1080 8000-8080). convert writes nftables.d/*.nft\n"
"  (defines + port sets).\n"
msgstr ""
"衝突策略（load / daemon）：\n"
"  預設              與現有 nft 設定衝突則中止\n"
"  -f, --force       覆寫衝突的活動規則（load）\n"
"  -n, --no-clobber  略過衝突變更，保留現有設定\n"
"\n"
"load -c/--compact 將匹配的 allow/deny statement 打包進 nft 集合。\n"
"unload 僅在整條活動規則完全匹配時移除 statement；\n"
"unload -f/--force 拆散殘餘的打包規則，盡可能多地移除原子。\n"
"show 為每條 statement 列印狀態：on、N/M、---、xxx。\n"
"\n"
"全域選項（可在 CMD 前或後）：\n"
"  -v, --verbose     DEBUG 日誌\n"
"  -q, --quiet       僅錯誤\n"
"  -h, --help        顯示說明\n"
"  --version         顯示版本\n"
"\n"
"說明：\n"
"  NAT（nat/dnat/redirect）在 prerouting/forward 處理，不會開放 INPUT。\n"
"  需要本機投遞的埠請用 allow incoming / whitelist（如 SSH）。\n"
"  deny incoming 丟棄埠；allow outgoing ip CIDR [tcp/udp PORT...] 過濾 OUTPUT\n"
"  （省略埠則匹配該 CIDR 的全部流量）。\n"
"  單一埠優先於區間；同等具體度時 allow 優先於 deny。\n"
"  dest address / dest interface 為 nat … to … 提供預設目標。\n"
"  TCP/UDP 匹配可為埠、區間（8000-8080）或列表（80 443 1080 8000-8080）。\n"
"  convert 寫出彙總的 nftables.d/*.nft。\n"

#: nftconf_app/cli.py:94
msgid "force overwrite on conflict"
msgstr "衝突時強制覆寫"

#: nftconf_app/cli.py:100
msgid "skip conflicting changes"
msgstr "略過衝突變更"

#: nftconf_app/cli.py:105 nftconf_app/cli.py:129
msgid "show actions without applying"
msgstr "顯示將執行的動作但不套用"

#: nftconf_app/cli.py:108
msgid "reconcile FILE against live nft"
msgstr "將 FILE 與活動 nft 規則對帳"

#: nftconf_app/cli.py:114 nftconf_app/cli.py:157
msgid "pack matching statements into nft sets"
msgstr "將匹配的 statement 打包進 nft 集合"

#: nftconf_app/cli.py:118
msgid "remove live rules for FILE statements"
msgstr "移除 FILE 中 statement 對應的活動規則"

#: nftconf_app/cli.py:124
msgid "split leftover compacted rules and remove matching atoms"
msgstr "拆散殘餘打包規則並移除匹配的原子"

#: nftconf_app/cli.py:132
msgid "show drift vs live nft"
msgstr "顯示與活動 nft 的差異"

#: nftconf_app/cli.py:135
